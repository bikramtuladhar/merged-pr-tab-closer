{
  "manifest_version": 3,
  "name": "Merged PR Tab Closer for GitHub",
  "version": "1.0.0",
  "description": "Groups merged GitHub pull request tabs and shows how many are open. Click the icon to close them all.",
  "permissions": [
    "scripting",
    "tabGroups"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "No merged PR tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Merged PR Closer",
  "homepage_url": "https://github.com/bikramtuladhar/merged-pr-tab-closer"
}
